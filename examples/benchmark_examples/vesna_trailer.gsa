GSA-PROJECT v1
{
  "path": "",
  "video": "",
  "source_video": "",
  "name": "vesna_trailer",
  "corpus": [
    {
      "id": "muxt86aekaegce",
      "text": "新的一天",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aesw800e",
      "text": "向你问候",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aeqe1ldj",
      "text": "至冬堡",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aeenbw9y",
      "text": "这是从纳塔进的珍品",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae2ujr9v",
      "text": "想办法弄到那批宝石",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aeg991jz",
      "text": "纳塔宝石",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aepyje6b",
      "text": "舞会",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aega3nbp",
      "text": "还有帮派",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae5zwiq1",
      "text": "世道不太平啊",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aem3888r",
      "text": "不用找了",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae28favs",
      "text": "薇斯纳大人",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae286767",
      "text": "薇斯纳",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aen8vdwh",
      "text": "这么热闹的舞会",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae7adznc",
      "text": "我怎么能缺席呢",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aeoskwtl",
      "text": "听说你们想要这批宝石",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae2l22u3",
      "text": "那真不好意思呀",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aext7qpr",
      "text": "我也盯上它了",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aexrhs60",
      "text": "可恶",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aeq3w6r8",
      "text": "以女皇之名",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aehcshg0",
      "text": "上吧",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aeapo8km",
      "text": "干完这一票",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae5jb43q",
      "text": "摩拉满地窖",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aeq55k12",
      "text": "爱做梦就到牢里去做吧",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae87ex5l",
      "text": "集群战术",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aevxcjg0",
      "text": "真是太感谢",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae2zujha",
      "text": "没想到这些家伙",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae32q6a2",
      "text": "还会惊动到冬契军",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae24ebmi",
      "text": "他们",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86ae2oyxht",
      "text": "当然不会",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aepoo8kn",
      "text": "捏造进口记录可是重罪",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aefes3t2",
      "text": "拿至冬禁用的炼金术来伪造宝石",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aegar5u3",
      "text": "就更罪加一等了",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aeawqzqg",
      "text": "所以你的下一场晚会",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    },
    {
      "id": "muxt86aen8jx5y",
      "text": "就到监狱里陪他们一起过吧",
      "source": "ocr_track",
      "created_at": "2026-10-07T07:52:34.261Z"
    }
  ],
  "corpus_ocr_diffs": [],
