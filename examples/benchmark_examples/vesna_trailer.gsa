        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xl4pszr7",
          "start": 247.6666192797065,
          "end": 248.6676192797065,
          "text": "…Huh?",
          "confidence": 0.94627046585083
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlp1xdch",
          "start": 250.63625261303983,
          "end": 252.15443594637316,
          "text": "Such a lively ball…",
          "confidence": 0.9097987413406372
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlcpux1k",
          "start": 252.6215692797065,
          "end": 253.6559359463732,
          "text": "How could I miss it?",
          "confidence": 0.9724626541137696
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xl8mkmmy",
          "start": 254.1230692797065,
          "end": 256.6255692797065,
          "text": "I hear you're after the gems?",
          "confidence": 0.9692826271057128
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlj2o90l",
          "start": 256.6255692797065,
          "end": 258.1604359463732,
          "text": "Well, I'm sorry…",
          "confidence": 0.9347177147865297
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xldx9axu",
          "start": 259.1280692797065,
          "end": 259.66193594637315,
          "text": "But so am I",
          "confidence": 0.9440990686416626
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlwftj8s",
          "start": 266.11838594637317,
          "end": 266.6522526130398,
          "text": "Ugh!",
          "confidence": 0.9967020153999328
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xl9so84w",
          "start": 275.61120261303984,
          "end": 276.6455692797065,
          "text": "For the Tsaritsa!",
          "confidence": 0.9944143891334534
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlliz9bu",
          "start": 277.11270261303986,
          "end": 277.6465692797065,
          "text": "Attack!",
          "confidence": 0.9306230545043944
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlg4p02l",
          "start": 286.65556927970647,
          "end": 288.65756927970654,
          "text": "Finish the job! We'll be rich! Charge…!",
          "confidence": 0.939602255821228
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xl7nh9nn",
          "start": 288.65756927970654,
          "end": 290.1590692797065,
          "text": "In your\ndreams, you're going to jail!",
          "confidence": 0.9830740094184875
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xl1z661s",
          "start": 290.6262026130398,
          "end": 291.6605692797065,
          "text": "Surround them!",
          "confidence": 0.9993728399276732
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlzzdieo",
          "start": 315.30085261303986,
          "end": 316.10165261303985,
          "text": "Thank you so much",
          "confidence": 0.9821462035179138
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlhz6gi8",
          "start": 316.10165261303985,
          "end": 317.7032526130398,
          "text": "I can't believe those brutes",
          "confidence": 0.9948946833610536
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlwe3wjl",
          "start": 317.7032526130398,
          "end": 318.7209359463732,
          "text": "Warranted the Druzhna…",
          "confidence": 0.9828788638114928
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlxnxve5",
          "start": 318.9878692797065,
          "end": 319.82203594637315,
          "text": "Them?",
          "confidence": 0.9955521821975708
        },
        {
          "type": "embed_ocr",
          "id": "muy7ut8vxq4b83",
          "start": 321.35690261303984,
          "end": 322.18310379611734,
          "text": "Oh, they didn't",
          "confidence": 0.9957813024520874
        },
        {
          "type": "embed_ocr",
          "id": "muy7ut8vwemql6",
          "start": 322.18310379611734,
          "end": 322.49136927970653,
          "text": "What?",
          "confidence": 0.9957813024520874
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xl93g0vi",
          "start": 322.49136927970653,
          "end": 325.26080261303986,
          "text": "… Fabricating\nimport logs is a crime",
          "confidence": 0.9339420199394226
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlhfjsyl",
          "start": 325.9448192797065,
          "end": 328.48068594637317,
          "text": "And\nusing\nforbidden alchemy to forge\ngemstones?",
          "confidence": 0.920661985874176
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xl15p12w",
          "start": 329.4149526130399,
          "end": 330.61615261303984,
          "text": "An aggravating factor",
          "confidence": 0.9837642908096312
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlccwzge",
          "start": 330.88308594637317,
          "end": 332.7015692797065,
          "text": "So, I hope you had a good night…",
          "confidence": 0.9837108850479126
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlw468ml",
          "start": 332.7015692797065,
          "end": 335.2374359463732,
          "text": "But the afterparty's gonna be in prison",
          "confidence": 0.9845141172409058
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlyti3dg",
          "start": 342.6448359463732,
          "end": 344.4966859463732,
          "text": "And using\nforbidden alchemy to forge\ngemstones?",
          "confidence": 0.974592924118042
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlhyf5tk",
          "start": 402.07086927970647,
