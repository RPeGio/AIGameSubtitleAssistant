          "start": 220.62293594637316,
          "end": 221.1901692797065,
          "text": "Ah…",
          "confidence": 0.8892068266868591
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xlri6czg",
          "start": 236.6055692797065,
          "end": 237.67330261303985,
          "text": "Lady Vesna!",
          "confidence": 0.9928492903709412
        },
        {
          "type": "embed_ocr",
          "id": "muxsq0xltfqzqr",
          "start": 243.6125692797065,
          "end": 245.14743594637315,
          "text": "Vesna…? Ugh!",
