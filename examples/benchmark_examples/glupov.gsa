    {
      "id": "muu1mit1773tb7",
      "name": "内嵌字幕 OCR",
      "type": "embed_ocr",
      "track_role": "game",
      "scope": "output",
      "page": "",
      "video": "clip",
      "preview_visible": true,
      "events": [
        {
          "type": "embed_ocr",
          "id": "muu1mit2smfz3h",
          "start": 69.44640992506358,
          "end": 75.88617659173025,
          "text": "Stepanyan\nOnyxAgate\nontinue tempering my will until I become a reliable company commander.",
          "confidence": 0.9867314100265504
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2vnjmx4",
          "start": 75.88617659173025,
          "end": 84.91185992506358,
          "text": "Stepanyan\nOnyx Agate\nHm? Oh, it's you… Glad to meet you again.",
          "confidence": 0.9472516775131226
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2o8apos",
          "start": 84.91185992506358,
          "end": 94.03764325839693,
          "text": "Stepanyan\nOnyxAgate\ny, my superiors put me in charge of all company affairs, and my duties became\nmuch more complicated overnight.",
          "confidence": 0.97958642244339
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2lji04z",
          "start": 94.03764325839693,
          "end": 106.76702659173026,
          "text": "Stepanyan\nOnyxAgate\nll the tedious, drawn-out paperwork and keeping a unit running smoothly is\nfundamentally different from fighting on the front lines.",
          "confidence": 0.9640591740608216
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit21ja1kq",
          "start": 106.76702659173026,
          "end": 115.2922099250636,
          "text": "Stepanyan\nOnyxAgate\nlls have become secondary. What matters more now is overall awareness, and\nthe ability to schedule and coordinate tasks.",
          "confidence": 0.9644157886505128
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2nnd82n",
          "start": 115.2922099250636,
          "end": 139.4163099250636,
          "text": "Stepanyan\nOnyx Agate\nAhh, I still prefer fighting on the front lines…",
          "confidence": 0.9672335982322692
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2ibxpci",
          "start": 139.4163099250636,
          "end": 163.45699325839692,
          "text": "Stepanyan\nOnyxAgate\nfer, tobecome a proper war machine, I must be capable in every respect.",
          "confidence": 0.9742192029953004
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2tgod1o",
          "start": 163.45699325839692,
          "end": 175.13532659173026,
          "text": "Stepanyan\nOnyx Agate\nnce deployed near the Experimental Design Bureau in Nod-Krai, and I had the\nchanging a few blows with you. You defeated me without breaking a sweat, of\ncourse.",
          "confidence": 0.9450749158859252
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2t48ozp",
          "start": 175.13532659173026,
          "end": 197.70787659173027,
          "text": "Stepanyan\nOnyx Agate\nNaturally, it's to be expected that you don't remember me.",
          "confidence": 0.9542921185493468
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2v4p4ye",
          "start": 197.70787659173027,
          "end": 224.19615992506357,
          "text": "Stepanyan\nOnyx Agate\n, at least a hundred Fatui soldiers who earned the Fireblade Shock Trooper\nqualification badge have fallen at your hands.",
          "confidence": 0.9505183100700378
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2bofftq",
          "start": 224.19615992506357,
          "end": 230.6574599250636,
          "text": "Stepanyan\nOnyx Agate\nmply think of me as an ordinary soldier, the kind you might find anywhere on\nthe roadside.",
          "confidence": 0.960034191608429
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2fs9bos",
          "start": 292.58328455542073,
          "end": 325.08441788875405,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\nlurderofBirds. I never thought I'd see you again here in Snezhnograd. What a\npleasant surprise.",
          "confidence": 0.7344334721565247
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2jxrp8n",
          "start": 325.08441788875405,
          "end": 331.0180222927876,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\nnton of the Ninth Company. Thank you for helping us back then, my friend.",
          "confidence": 0.9702173471450806
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2f668to",
          "start": 331.0180222927876,
          "end": 448.8491448820126,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\nve at the moment. If there's anything I can help you with, just say the word.",
          "confidence": 0.9651342034339904
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit258qbn8",
          "start": 448.8491448820126,
          "end": 461.8017729762795,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\nwell enough. Danila, Temur, Radomir, and the rest of my soldiers are all still\nalive. They are currently recovering in Glupov.",
          "confidence": 0.9662891030311584
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2mdpd6c",
          "start": 461.8017729762795,
          "end": 473.16568455542074,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\nDened in The Chasm took a great deal out of them, but fortunately, the Ninth\nremains intact. We did not bring shame upon our ancestorsor Her Majesty.",
          "confidence": 0.9547444581985474
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2v53gox",
          "start": 473.16568455542074,
          "end": 531.0832845554207,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\none has recovered their strength, we will be ready for new orders at any time.\ner Majesty's great wish is fulfilled, we may die, but we will not be broken.",
          "confidence": 0.9644027948379515
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2hh5ggz",
          "start": 531.0832845554207,
          "end": 535.0274845554208,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\n…",
          "confidence": 0.9695813655853271
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2vozm0t",
          "start": 535.0274845554208,
          "end": 545.5832845554207,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\nNo news. But perhaps… no news is the best news.",
          "confidence": 0.9444907307624816
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2ivjtqe",
          "start": 545.5832845554207,
          "end": 566.625717888754,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\nKolya… They are children of the House of the Hearth. They Value the bonds of\nfamily far more than we do.",
          "confidence": 0.960259735584259
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit2ot9i8m",
          "start": 566.625717888754,
          "end": 571.1649173196965,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\nIf they are still alive, I hope they never come back here.",
          "confidence": 0.962043046951294
        },
        {
          "type": "embed_ocr",
          "id": "muu1mit27s19mz",
          "start": 571.1649173196965,
          "end": 584.2433178887541,
          "text": "Anton\nFormer Acting Captain,\"Ninth Company\nat they deserted the Fatui, escaped somewhere safe, and survived. So for me.",
          "confidence": 0.9697028994560242
        }
      ]
    }
