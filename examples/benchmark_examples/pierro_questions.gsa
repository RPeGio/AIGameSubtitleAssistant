    {
      "id": "mtuc9bbivl801v",
      "name": "OCR 选区（剧情录屏）",
      "type": "ocr_region",
      "track_role": "game",
      "scope": "control",
      "page": "corpus",
      "video": "source",
      "preview_visible": true,
      "events": [
        {
          "type": "ocr_region",
